{
  "name": "shadowblade",
  "private": true,
  "version": "1.0.0",
  "description": "Shadowblade - a 2D sword-swinging platformer written in TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:level": "node tools/verify-level.mjs",
    "playtest": "node tools/playtest.mjs",
    "screenshots": "node tools/screenshots.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
